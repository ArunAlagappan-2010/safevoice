<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 8.1+: light status and navigation bars with dark icons. -->
    <style name="SafeVoiceTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/mist</item>
        <item name="android:statusBarColor">@color/mist</item>
        <item name="android:navigationBarColor">@color/mist</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/teal</item>
        <item name="android:colorPrimary">@color/teal</item>
    </style>
</resources>
