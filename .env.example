# Copy this file to .env and fill in what you need. Everything is optional.

# AI for triage and reply suggestions. Set one key; without any, the built-in rule engine is used.
# Gemini (free key from https://aistudio.google.com/apikey):
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Or Claude:
ANTHROPIC_API_KEY=
# If both keys are set, Gemini is used unless SAFEVOICE_AI=claude.

# PIN for the counsellor dashboard.
COUNSELLOR_PIN=2468

# Port to listen on.
PORT=3000
